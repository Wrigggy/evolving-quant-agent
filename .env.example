# QEA v0 environment.
# Copy to .env and fill in for a REAL run. The mock smoke test needs none of this.

# ---- Mock mode (default for the smoke test) --------------------------------
# When MOCK_LLM=1, no network / no API key is used; the loop runs a scripted,
# deterministic world model that exercises every path. `python run.py --mock`
# sets this automatically.
MOCK_LLM=1

# ---- Real mode (OpenRouter) ------------------------------------------------
# All three roles (quant_agent, evolve_agent, soft judge) default to one model.
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

QEA_QUANT_AGENT_MODEL="deepseek/deepseek-v4-pro"
QEA_EVOLVE_AGENT_MODEL="deepseek/deepseek-v4-pro"
# The judge drives the GDPval-AA pairwise gate. Artificial Analysis grades
# GDPval-AA with Gemini 3.1 Pro Preview — set this to match their protocol
# (and drop "deepseek" from QEA_PROVIDER_ORDER, or judge calls will fail):
#   QEA_JUDGE_MODEL="google/gemini-3.1-pro-preview"
QEA_JUDGE_MODEL="deepseek/deepseek-v4-pro"

# Pin the native provider for tool-use compatibility (AHE lesson: routed
# providers can return empty / mis-parsed tool calls). Comma-separated.
QEA_PROVIDER_ORDER="deepseek"

# Throughput / resilience (AHE lessons: >10 concurrency hit 429s).
QEA_MAX_CONCURRENCY=8
QEA_MAX_RETRIES=5
QEA_BACKOFF_BASE_SEC=2.0
