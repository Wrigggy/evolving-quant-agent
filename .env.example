# QEA v0 environment.
# Copy to .env and fill in for a REAL run. The mock smoke test needs none of this.

# ---- Mock mode (default for the smoke test) --------------------------------
# When MOCK_LLM=1, no network / no API key is used; the loop runs a scripted,
# deterministic world model that exercises every path. `python run.py --mock`
# sets this automatically.
MOCK_LLM=1

# ---- Real mode (OpenRouter) ------------------------------------------------
# All three roles (quant_agent, evolve_agent, soft judge) default to one model.
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

QEA_QUANT_AGENT_MODEL="deepseek/deepseek-v4-pro"
QEA_EVOLVE_AGENT_MODEL="deepseek/deepseek-v4-pro"
# The judge drives the GDPval-AA pairwise gate. Artificial Analysis grades
# GDPval-AA with Gemini 3.1 Pro Preview — set QEA_JUDGE_MODEL to
# "google/gemini-3.1-pro-preview" to match their protocol exactly; without
# Gemini access, "qwen/qwen3.7-max" is a strong cross-family judge.
QEA_JUDGE_MODEL="qwen/qwen3.7-max"

# Every model is pinned to its OFFICIAL provider, allow_fallbacks=false (AHE
# lesson: routed providers return empty / mis-parsed completions). Built-in map:
# deepseek=deepseek, qwen=alibaba. Extend/override with
#   QEA_PROVIDER_MAP="prefix=provider,..."   (e.g. "google=google-ai-studio")
# Legacy QEA_PROVIDER_ORDER entries become identity pins (p=p).
QEA_PROVIDER_ORDER="deepseek"

# Throughput / resilience (AHE lessons: >10 concurrency hit 429s).
QEA_MAX_CONCURRENCY=8
QEA_MAX_RETRIES=5
QEA_BACKOFF_BASE_SEC=2.0

# ---- Stirrup base-harness test (qea/stirrup-e2b-base-harness) ----------------
# E2B SaaS sandbox key. Copy the working key from
# ../agentic-harness-engineering/.env (real key already present there).
# SaaS default: set ONLY this (leave E2B_API_URL / E2B_DOMAIN unset).
E2B_API_KEY="e2b_..."
# Multimodal judge -- no Gemini access, use a Qwen-VL (vision) model. Confirm the
# exact OpenRouter slug at run time; fallback "qwen/qwen-vl-max".
# (Set QEA_JUDGE_MODEL above to the VL slug when running the base-harness test.)
# Agentic turn cap (GDPval tasks with real reference files need more steps),
# E2B concurrent-sandbox cap (your account limit), judge k-repeat, LLM transport
# retries (recover the single output through a flaky proxy; not a task re-roll).
QEA_STIRRUP_MAX_TURNS=40
QEA_MAX_E2B=20
QEA_LLM_MAX_RETRIES=6
QEA_JUDGE_K=2
