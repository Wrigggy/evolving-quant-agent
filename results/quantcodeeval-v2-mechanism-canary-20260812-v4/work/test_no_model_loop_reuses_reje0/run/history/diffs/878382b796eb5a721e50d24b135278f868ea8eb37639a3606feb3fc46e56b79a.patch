--- a/tool_descriptions/robust_estimator.tool.yaml
+++ b/tool_descriptions/robust_estimator.tool.yaml
@@ -0,0 +1,11 @@
+type: tool
+name: robust_estimator
+description: Compute a deterministic arithmetic estimate.
+input_schema:
+  type: object
+  properties:
+    values:
+      type: array
+      items: {type: number}
+  required: [values]
+  additionalProperties: false
--- a/tools/robust_estimator.py
+++ b/tools/robust_estimator.py
@@ -0,0 +1,3 @@
+def robust_estimator(values):
+    values = [float(value) for value in values]
+    return {'estimate': sum(values) / len(values)}
